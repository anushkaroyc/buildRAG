# Copy to .env and fill in.   cp .env.example .env
# .env is gitignored. Never commit a real key.

# ── Groq (required to ANSWER; the app still boots without it) ─────────────
# Missing key => the app starts and reports itself unconfigured. It never
# fabricates an answer (PRD §5 ST-2).
GROQ_API_KEY=

# ── Model IDs (docs/architecture.md §8) ───────────────────────────────────
# Groq rotates its free-tier model lineup; pin explicitly.
# GROQ_MODEL is the answer-generation model. (LLM_MODEL is still accepted as a
# fallback name for older configs, but new files should use GROQ_MODEL.)
GROQ_MODEL=openai/gpt-oss-20b
# The advice/injection guard. Separate, much smaller, called only for questions
# the deterministic patterns cannot place.
GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m

# Mandated by the brief (docs/ProblemStatement.txt line 46).
# Load via ONNX / fastembed. Do NOT switch to the `sentence-transformers`
# library to load it -- that pulls in torch (~660-930 MB) and OOMs Render's
# 512 MB free tier (docs/architecture.md §9.1).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────
TOP_K=5
# Below this cosine score we answer "I don't have that in my sources" instead
# of guessing (ST-1). Tune against the golden set in Phase 5.
MIN_SCORE=0.35
# Require at least one content word from the question to actually appear in the
# retrieved text before answering. Catches "relevant page, wrong fact".
REQUIRE_CONTEXT_SUPPORT=true

# ── Guardrails (Phase 4) ───────────────────────────────────────────────────
# How the advice/injection guard decides. The 22M model is a jailbreak
# classifier, not a financial-advice classifier, so the deterministic patterns
# decide first and it is consulted only for questions they cannot place.
#   auto     - patterns first, model only for ambiguous questions (default)
#   model    - model first, patterns as the backstop
#   keywords - never call the network (offline demo, zero-token budget)
GUARD_MODE=auto
GUARD_TIMEOUT_S=5.0
# If the guard is unreachable and a question cannot be placed, refuse rather
# than guess. Leave true; setting it false answers ambiguous questions blind.
GUARD_FAIL_CLOSED=true

# ── Paths ─────────────────────────────────────────────────────────────────
CHROMA_PATH=data/chroma
SOURCES_CSV=data/sources.csv

# ── Server ────────────────────────────────────────────────────────────────
# Render injects PORT; uvicorn is started with --port $PORT.
PORT=10000
