# Copy to .env and fill in.   cp .env.example .env
# .env is gitignored. Never commit a real key.

# ── Groq (required to ANSWER; the app still boots without it) ─────────────
# Missing key => the app starts and reports itself unconfigured. It never
# fabricates an answer (PRD §5 ST-2).
GROQ_API_KEY=

# ── Model IDs (docs/architecture.md §8) ───────────────────────────────────
# Groq rotates its free-tier model lineup; pin explicitly.
LLM_MODEL=openai/gpt-oss-20b
GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m

# Mandated by the brief (docs/ProblemStatement.txt line 46).
# Load via ONNX / fastembed. Do NOT switch to the `sentence-transformers`
# library to load it -- that pulls in torch (~660-930 MB) and OOMs Render's
# 512 MB free tier (docs/architecture.md §9.1).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────
TOP_K=5
# Below this cosine score we answer "not in my corpus" instead of guessing.
# Tune against the golden set in Phase 5 (docs/architecture.md §8).
MIN_SCORE=0.35

# ── Paths ─────────────────────────────────────────────────────────────────
CHROMA_PATH=data/chroma
SOURCES_CSV=data/sources.csv

# ── Server ────────────────────────────────────────────────────────────────
# Render injects PORT; uvicorn is started with --port $PORT.
PORT=10000
